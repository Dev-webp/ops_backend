# Copy this file to ".env" and fill in your own values

# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vjc_ops

# Set to "true" only if your Postgres provider requires SSL (e.g. some cloud hosts)
DB_SSL=false

# Any long random string — used to sign login sessions (JWT)
JWT_SECRET=change_this_to_a_long_random_string

# Port the API runs on
PORT=4000

# URL(s) of the React frontend allowed to call this API (comma-separated)
CLIENT_URL=http://localhost:5173

# Shared secret used by the Invoice Portal when it pushes leads to OPS
OPS_INTERNAL_API_KEY=change_this_too

# Only needed if frontend and API are on DIFFERENT domains in production:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
